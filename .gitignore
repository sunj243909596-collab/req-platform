# ===== 本机个人配置（严禁入库） =====
**/.claude/                # 任意子目录下的 .claude 配置（含 settings.local.json）
claude --resume *

# ===== Node / 包管理 =====
node_modules/
dist/
*.tsbuildinfo
.npm/
.pnpm-store/

# ===== 环境变量与密钥 =====
.env
.env.local
.env.*.local
agent-config.json

# ===== 业务数据与文档（不入库） =====
docs/*
!docs/DEPLOY.md
CODE_MAP.md
server/uploads/

# ===== 临时与日志 =====
.dev/
.uploads/
tmp/
*.log
*.tmp
*.bak
*.bak.*

# ===== IDE / 编辑器残留 =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
