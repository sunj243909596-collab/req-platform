# =============================================================================
# WMS 需求管理平台 — 生产环境变量模板
# 复制到 server/.env 并修改所有占位符
#   cp deploy/env/server.env.production.example server/.env
#   chmod 600 server/.env
# =============================================================================

# --- 基础服务 ---
DATABASE_URL="postgresql://req_admin:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/req_platform_db?schema=public"
JWT_SECRET="CHANGE_ME_USE_openssl_rand_hex_32"
# 必须与浏览器访问的前端域名完全一致（含协议，无尾斜杠）
CORS_ORIGIN="https://req.example.com"
PORT=8001
NODE_ENV=production

# --- LLM / Agent ---
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-xxx"
OPENAI_API_KEY="sk-xxx"
LLM_MODEL="claude-sonnet-4-20250514"

# --- Embedding / RAG ---
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-v3"
EMBEDDING_API_KEY="sk-xxx"

# 知识库源目录（生产服务器上的实际路径，逗号分隔）
KB_SOURCES="/data/wmos-knowledge,/data/wmos-design"

# 生产环境建议关闭启动时全量 RAG 重建（首次部署后可手动触发）
RAG_STARTUP_REINDEX=false
RAG_STARTUP_REQ_REINDEX=false
