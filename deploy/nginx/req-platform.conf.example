# WMS 需求管理平台 — Nginx 站点配置模板
#
# 安装：
#   sudo cp deploy/nginx/req-platform.conf.example /etc/nginx/sites-available/req-platform
#   sudo ln -sf /etc/nginx/sites-available/req-platform /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# 占位符（部署脚本会自动替换）：
#   __DOMAIN__       站点域名，如 req.example.com
#   __ROOT__         前端 dist 绝对路径，如 /opt/req-platform/client/dist
#   __BACKEND_PORT__ 后端端口，默认 8001

upstream req_platform_backend {
    server 127.0.0.1:__BACKEND_PORT__;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # certbot 会自动添加 HTTPS 重定向；若手动配置 TLS，在此 server 块前添加 443 块

    client_max_body_size 25m;

    root __ROOT__;
    index index.html;

    access_log /var/log/nginx/req-platform.access.log;
    error_log  /var/log/nginx/req-platform.error.log;

    # 静态资源长缓存
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # API 反向代理
    location /api/ {
        proxy_pass http://req_platform_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # SSE / 流式 AI 响应
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
