# Server
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/req_platform_db?schema=public"
JWT_SECRET="your-jwt-secret-change-in-production"
# 生产环境必须设置为具体域名，禁止使用 * 或 localhost
CORS_ORIGIN="https://your-production-domain.com"
PORT=8001

# LLM API (Agent)
LLM_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-xxx"
OPENAI_API_KEY="sk-xxx"
LLM_MODEL="claude-sonnet-4-20250514"
# Embedding: put real key in server/.env (git-ignored) — never in agent-config.json
EMBEDDING_MODEL="text-embedding-v3"
EMBEDDING_PROVIDER="openai"
EMBEDDING_API_KEY=""

# Knowledge Base Sources (comma-separated paths)
KB_SOURCES="/root/WMOS 知识库,/root/WMOS 设计工场,/mnt/f/bar-local"
